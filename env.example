# Copy to .env and fill in.

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# OpenAI — https://platform.openai.com/api-keys
# Only one provider's key is needed; whichever the code imports is the one used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Test data referenced by `valueRef` in generated plans.
# Plans store only the names, never the values.
TEST_EMAIL=
TEST_PASSWORD=
